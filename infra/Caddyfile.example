# UltiArena behind ultiarena.hu via Cloudflare Tunnel — copy to infra/Caddyfile
# (the real file is gitignored so local tweaks never land in git).
#
# Chain: internet → Cloudflare (TLS) → cloudflared tunnel → 127.0.0.1:8080 (Caddy)
#        → 127.0.0.1:8000 (apps/serve.sh).
#
# LOOPBACK ONLY: the app's per-IP abuse limits trust CF-Connecting-IP, which is only
# safe while the tunnel is the sole way in — never bind this (or the app) to 0.0.0.0.
#
# To gate the whole site behind a shared password, uncomment basic_auth and paste a
# hash from: caddy hash-password
{
    auto_https off
    admin off
}

# :8080 = match ANY Host (the tunnel forwards Host: ultiarena.hu — a host-qualified
# address like http://127.0.0.1:8080 would silently match nothing and serve empty
# 200s); `bind` is what restricts the LISTENER to loopback.
:8080 {
    bind 127.0.0.1
    encode gzip
    request_body {
        max_size 64KB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    # basic_auth {
    #     ulti {PASTE_HASH_FROM: caddy hash-password}
    # }
    reverse_proxy 127.0.0.1:8000
}
